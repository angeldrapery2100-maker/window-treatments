    {
      "class": "Wool",
      "match": [
        "wool",
        "merino"
      ],
      "from": [
        "material"
      ]
    },
    {
      "class": "Linen",
      "minShare": {
        "LINEN": 45
      }
    },
    {
      "class": "Cotton",
      "minShare": {
        "COTTON": 45
      }
    },
    {
      "class": "Polyester",
      "minShare": {
        "POLYESTER": 70,
        "RECYCLED POLYESTER": 70
      }
    },
    {
      "class": "Viscose",
      "minShare": {
        "VISCOSE": 45,
        "RAYON": 45
      }
    },
    {
      "class": "Performance",
      "match": [
        "olefin",
        "polypropylene",
        "acrylic",
        "solution dyed"
      ],
      "from": [
        "material"
      ]
    }
  ],
