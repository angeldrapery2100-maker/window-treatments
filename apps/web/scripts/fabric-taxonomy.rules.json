{
  "_doc": [
    "Rule table for build-fabric-catalog.mjs. Edited by hand; the build script",
    "never writes to this file. Anything you want to correct for ONE fabric goes",
    "in fabric-taxonomy.overrides.json instead (overrides win over every rule).",
    "Matching is case-insensitive, on whole words unless the token contains a space."
  ],
  "materialClasses": [
    {
      "class": "Velvet",
      "match": [
        "velvet",
        "velour",
        "chenille"
      ],
      "from": [
        "material",
        "patternName",
        "book"
      ]
    },
    {
      "class": "Silk",
      "match": [
        "silk",
        "dupioni",
        "shantung"
