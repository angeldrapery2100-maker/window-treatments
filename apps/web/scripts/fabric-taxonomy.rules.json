  "_styleNote": "First rule that matches wins, so the list is ordered most-specific first. Matched against patternName + book only — never the fibre content, which mislabels a third of the library off one word. Rows that match nothing are left blank on purpose: an unlabelled style filters out cleanly, a wrong one misleads.",
  "priceBands": {
    "_doc": "Quartile cut over every fabric that has a price, recomputed on each run and printed in the build log.",
    "labels": [
      "$",
      "$$",
      "$$$",
      "$$$$"
    ]
  },
  "sheerBooks": [
    "sheer",
    "voile",
    "transparency",
    "organza",
    "gauze",
    "batiste"
  ],
  "_sheerNote": "yarnFabric from the source catalogs is the primary signal; these tokens only promote a row to sheer when the source left it as 布.",
  "textureThresholds": {
    "_doc": "Swatch-photo fallback for rows with no pattern keyword. sd = mean per-channel standard deviation of the centre crop (metrics.json).",
    "solidMaxSd": 4.5,
    "textureMaxSd": 14,
    "motifRepeatIn": 2.5
  },
  "multiColor": {
    "_doc": "Multi needs at least minDistinctHues chromatic families among the significant clusters AND those clusters must be perceptually far apart (deltaE), otherwise a pale tone-on-tone print quantises into three neighbouring 'families' and reads as multicoloured.",
    "minClusterShare": 0.12,
    "minDistinctHues": 3,
    "minDeltaE": 26
  },
  "colorThresholds": {
    "_doc": "CIELCh cuts used by familyFromRgb(). L 0-100 lightness, C chroma (0 = grey), h CIELab hue in degrees (red ~40, yellow ~100, green ~135, teal ~190, blue ~270, magenta ~340).",
    "greyMaxChroma": 1.5,
    "tintedGreyMaxChroma": 7,
    "whiteMinL": 88,
    "blackMaxL": 26,
    "warmHueLow": 50,
    "warmHueHigh": 100,
    "warmSaturated": 30,
    "orangeHueHigh": 72,
    "creamMinL": 77,
    "creamMaxChroma": 11,
    "midNeutralMinL": 55,
    "taupeMaxChroma": 11,
    "brownMaxL": 36,
    "pinkMinL": 68,
    "greenHueLow": 100,
    "tealHueLow": 168,
    "blueHueLow": 232,
    "purpleHueLow": 312,
    "pinkHueLow": 345
  }
